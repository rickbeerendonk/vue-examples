{
  "name": "vue-examples",
  "version": "1.0.0",
  "description": "Examples for [Vue.js](https://vuejs.org).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rickbeerendonk/vue-examples.git"
  },
  "author": "Rick Beerendonk",
  "license": "EUPL-1.2",
  "bugs": {
    "url": "https://github.com/rickbeerendonk/vue-examples/issues"
  },
  "homepage": "https://github.com/rickbeerendonk/vue-examples#readme",
  "husky": {
    "hooks": {
      "pre-commit": "npm run validate"
    }
  },
  "scripts": {
    "clean": "rimraf node_modules",
    "eslint": "eslint . --ext .js,.jsx,.vue --cache",
    "eslint-fix": "eslint . --ext .js,.jsx,.vue --cache --fix",
    "open": "open",
    "openserver": "node ./server/server.js",
    "prettier": "prettier --list-different '**/*.{json,js,jsx,html,md,vue}'",
    "prettier-fix": "prettier --write '**/*.{json,js,jsx,html,md,vue}'",
    "validate": "npm run eslint && npm run prettier",
    "start": "npm run openserver -- \".\""
  },
  "devDependencies": {
    "@babel/cli": "^7",
    "@babel/core": "^7",
    "@babel/eslint-parser": "^7",
    "@babel/preset-env": "^7",
    "@tsconfig/node22": "^22",
    "@types/node": "^24",
    "@typescript-eslint/eslint-plugin": "^8",
    "@vitejs/plugin-vue": "^6",
    "@vitejs/plugin-vue-jsx": "^5",
    "@vue/babel-helper-vue-jsx-merge-props": "^1",
    "@vue/babel-preset-jsx": "^1",
    "@vue/tsconfig": "^0",
    "babel-loader": "^10",
    "copy-webpack-plugin": "^13",
    "core-js": "^3",
    "css-loader": "^7",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "eslint-plugin-prettier": "^5",
    "eslint-plugin-vue": "^10",
    "html-webpack-plugin": "^5",
    "husky": "^4",
    "npm-run-all2": "^8",
    "prettier": "^3",
    "style-loader": "^4",
    "typescript": "^5",
    "vite": "^7",
    "vite-plugin-vue-devtools": "^8",
    "vue-eslint-parser": "^10",
    "vue-loader": "^17",
    "vue-template-compiler": "^2",
    "vue-tsc": "^3",
    "webpack": "^5",
    "webpack-cli": "^5",
    "webpack-dev-server": "^5"
  },
  "dependencies": {
    "http-vue-loader": "^1",
    "pinia": "^3",
    "serve": "^14",
    "vue": "^3",
    "vue-router": "^4",
    "vuex": "^4"
  }
}
